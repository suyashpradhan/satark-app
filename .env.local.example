# Copy this file to .env.local and add your key. Never commit .env.local.
SARVAM_API_KEY=sk_your_key_here

# Public browser configuration from PostHog Project settings.
# Keep the US/EU host exactly as PostHog provides it.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
